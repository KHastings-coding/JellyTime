# JellyTime Configuration
# Copy this to .env and edit

# Port to expose the app on (default 3000)
PORT=3000

# IMPORTANT: Change this to a random secret in production!
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-string

# Optional: pre-configure Jellyfin on first boot (skips Jellyfin setup step)
# JELLYFIN_URL=http://192.168.1.x:8096
# JELLYFIN_API_KEY=your-api-key-here
